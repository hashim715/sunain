generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}

model User {
  id Int @id @default(autoincrement())
  name String
  username String @unique
  email String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token String?
  google_login Boolean @default(false)
  google_access_token String?
  google_refresh_token String?
  google_token_expiry String?
  expiresAt String?
  phone_number String? @unique
  profile_image String?
  details_added Boolean @default(false)
  date_of_birth String?
  gender String?
  race String?
  area_grown_up String?
  language String?
  city String?
  language_dialect String?
  education_level String?
  language_skills String[] @default(["Speaking", "Listening", "Reading", "Writing"])
  language_proficieny Int[]
  language_use String[]
  quiz_answers String[]
  user_type String @default("user")
  verification_token String?
  verification_secret String?
  verification_token_expiry String?
  verified Boolean @default(false)
  adminVerify Boolean @default(false)
  meetings Meeting[]
}

model Meeting {
  id           String    @id @default(uuid())
  sessionName  String    
  passcode     String
  userId       Int       @map("user_id")
  role         String    @default("participant") 
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")
  duration     Int?      
  isActive     Boolean   @default(true) @map("is_active")
  
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionName])
  @@index([isActive])
  @@map("meetings")
}

model Recording {
  id                Int      @id @default(autoincrement())
  meetingName       String
  recordingNumber   Int
  participantNumber Int
  s3Key             String
  s3Url             String
  recordingStartTime DateTime  
  status            String   @default("processing")
  createdAt         DateTime @default(now())

  @@index([meetingName, recordingNumber])
  @@index([meetingName, recordingStartTime])
}

model RecordingSession {
  id              Int      @id @default(autoincrement())
  meetingName     String
  recordingNumber Int
  recordingStartTime DateTime  
  isRecording     Boolean  @default(false)
  startedAt       DateTime @default(now())
  participantCount Int     @default(0)
  status          String   @default("active") 
  
  @@unique([meetingName, recordingNumber])
  @@index([meetingName])
}